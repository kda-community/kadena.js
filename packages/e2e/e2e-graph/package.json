{
  "name": "e2e-graph",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "format": "pnpm run --sequential /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:src": "prettier . --cache --write",
    "install:chromium": "npx playwright install chromium --with-deps",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "eslint . --ext .js,.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kda-community/chainweb-node-client": "workspace:*",
    "@kda-community/client": "workspace:*",
    "@kda-community/client-utils": "workspace:*",
    "@kda-community/cryptography-utils": "workspace:*",
    "@kda-community/graph": "workspace:*",
    "@kda-community/pactjs": "workspace:*",
    "@kda-community/pactjs-cli": "workspace:*"
  },
  "devDependencies": {
    "@kda-community-dev/e2e-base": "workspace:*",
    "@kda-community-dev/eslint-config": "workspace:*",
    "@kda-community-dev/eslint-plugin": "workspace:*",
    "@kda-community-dev/lint-package": "workspace:*",
    "@kda-community-dev/markdown": "workspace:*",
    "@kda-community-dev/shared-config": "workspace:*",
    "@kda-community/types": "workspace:*",
    "@playwright/test": "^1.45.3",
    "@rushstack/eslint-config": "~3.6.9",
    "@types/node": "^20.12.7",
    "directory-tree": "3.5.1",
    "eslint": "^8.45.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-playwright": "1.6.2",
    "graphql-ws": "^5.16.0",
    "parse-md": "2.0.5",
    "playwright-i18next-fixture": "^1.0.0",
    "prettier": "~3.2.5",
    "ws": "^8.16.0"
  }
}
