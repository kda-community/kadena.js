{
  "name": "@kda-community/kadena-cli",
  "version": "1.4.6",
  "description": "Kadena CLI tool to interact with the Kadena blockchain (manage keys, transactions, etc.)",
  "keywords": [
    "Kadena",
    "CLI",
    "Contracts",
    "Transactions",
    "Wallet",
    "Sign"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kda-community/kadena.js.git",
    "directory": "packages/tools/kadena-cli"
  },
  "license": "BSD-3-Clause",
  "contributors": [
    "Danillo Felixdaal <danillo@kda-community.io>",
    "Albert Groothedde <albert@kda-community.io",
    "Jesse van Muijden <jesse@kda-community.io",
    "Jermaine Jong <jermaine@kda-community.io",
    "Javad Khalilian <javad@kda-community.io>",
    "Mohamed Ismail <mohamed@kda-community.io>",
    "Bart Huijgen <bart@kda-community.io>"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "kadena": "./lib/index.js"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.js.map",
    "!lib/**/*.d.ts",
    "!lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "pnpm run generate:all && tsc",
    "bundle": "rollup -c rollup.config.mjs",
    "dev": "swc --config-file .swcrc ./src -d lib --strip-leading-paths -q && NODE_ENV=development KADENA_LOG=debug node lib/index.js",
    "format": "pnpm run /^format:.*/",
    "format:md": "remark README.md -o --use @kda-community-dev/markdown",
    "format:src": "prettier config src --write",
    "generate:all": "cache-sh -i \"node_modules/.kadena/**\" -- pnpm run \"/^generate:pact:.*/\"",
    "generate:pact:faucet": "pactjs contract-generate --contract user.coin-faucet --api https://api.testnet.chainweb.com/chainweb/0.0/testnet04/chain/1/pact",
    "generate:pact:kdn:mainnet": "pactjs contract-generate --contract n_32faa22a75da53789d48dcbcb124a11c8f8651a8.kadena-names --api https://api.testnet.chainweb.com/chainweb/0.0/testnet04/chain/1/pact",
    "generate:pact:kdn:testnet": "pactjs contract-generate --contract n_32faa22a75da53789d48dcbcb124a11c8f8651a8.herdyracle --api https://api.testnet.chainweb.com/chainweb/0.0/testnet04/chain/1/pact",
    "kadena": "swc --config-file .swcrc ./src -d lib --strip-leading-paths -q && node lib/index.js",
    "lint": "eslint src --ext .js,.ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@inquirer/prompts": "3.3.0",
    "@kda-community/client": "workspace:^",
    "@kda-community/client-utils": "workspace:*",
    "@kda-community/cryptography-utils": "workspace:*",
    "@kda-community/hd-wallet": "workspace:*",
    "@kda-community/pactjs": "workspace:*",
    "@kda-community/pactjs-cli": "workspace:^",
    "@kda-community/pactjs-generator": "workspace:*",
    "@scure/bip39": "1.2.1",
    "chalk": "^5.2.0",
    "cli-table3": "0.6.4",
    "commander": "^11.0.0",
    "js-yaml": "~4.1.0",
    "memfs": "~3.5.1",
    "ora": "7.0.1",
    "sanitize-filename": "1.6.3",
    "seedrandom": "~3.0.5",
    "ttys": "0.0.3",
    "zod": "~3.23.0"
  },
  "devDependencies": {
    "@kda-community-dev/eslint-config": "workspace:*",
    "@kda-community-dev/markdown": "workspace:*",
    "@kda-community-dev/shared-config": "workspace:*",
    "@kda-community/types": "workspace:*",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rushstack/eslint-config": "~3.6.9",
    "@rushstack/heft": "~0.50.6",
    "@swc/cli": "^0.4.0",
    "@swc/core": "~1.3.78",
    "@types/heft-jest": "~1.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20.12.7",
    "@types/seedrandom": "~3.0.8",
    "@vitest/coverage-v8": "^1.6.0",
    "cache-sh": "^1.2.1",
    "eslint": "^8.45.0",
    "msw": "^2.2.14",
    "prettier": "~3.2.5",
    "rollup": "^4.17.2",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
