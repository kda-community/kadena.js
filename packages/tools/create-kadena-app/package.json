{
  "name": "@kadena/create-kadena-app",
  "version": "0.2.1",
  "description": "CLI tool to create a starter project with @kadena/client integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/tools/create-kadena-app"
  },
  "license": "ISC",
  "contributors": [
    {
      "name": "Jermaine Jong",
      "email": "jermaine@kadena.io"
    },
    {
      "name": "Mohamed Ismail",
      "email": "mohamed@kadena.io"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": {
    "create-kadena-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "vite build",
    "cleanup": "rimraf dist",
    "copy": "node ./src/scripts/copy.mjs",
    "format": "prettier config src templates --write",
    "lint": "oxlint .",
    "start": "ts-node --transpile-only src/index.ts",
    "test": "echo 'No unit tests'",
    "test:integration": "rimraf test-* && cross-env NG_CLI_ANALYTICS=false ./scripts/generate-test.sh"
  },
  "dependencies": {
    "chalk": "^5.2.0",
    "commander": "^11.0.0",
    "cross-fetch": "~3.1.5",
    "cross-spawn": "~7.0.3",
    "yaml": "~2.1.1"
  },
  "devDependencies": {
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@types/cross-spawn": "~6.0.2",
    "@types/debug": "~4.1.12",
    "@types/heft-jest": "~1.0.6",
    "@types/mkdirp": "~1.0.2",
    "@types/node": "^20.12.7",
    "@types/rimraf": "~3.0.2",
    "cross-env": "~7.0.3",
    "oxlint": "1.63.0",
    "prettier": "~3.2.5",
    "recursive-copy": "^2.0.14",
    "rimraf": "~5.0.1",
    "ts-node": "~10.9.2",
    "typescript": "5.4.5",
    "vite": "8.0.10"
  }
}
