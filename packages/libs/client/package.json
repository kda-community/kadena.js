{
  "name": "@kadena/client",
  "version": "1.18.3",
  "description": "Core library for building Pact expressions to send to the blockchain in js. Makes use of .kadena/pactjs-generated",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/client"
  },
  "license": "BSD-3-Clause",
  "contributors": [
    "Albert Groothedde <albert@kadena.io>",
    "Javad Khalilian <javad@kadena.io>",
    "Ashwin van Dijk <ashwin@kadena.io>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./fp": {
      "types": "./src/fp.ts",
      "development": "./src/fp.ts",
      "import": "./dist/fp.mjs",
      "require": "./dist/fp.cjs",
      "default": "./dist/fp.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "fp": [
        "./dist/fp.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "format": "pnpm run --sequential /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:md": "remark README.md -o --use @kadena-dev/markdown",
    "format:src": "prettier . --cache --write",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "oxlint .",
    "start": "ts-node --transpile-only src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c ./vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kadena/chainweb-node-client": "workspace:*",
    "@kadena/cryptography-utils": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@walletconnect/sign-client": "~2.8.1",
    "cross-fetch": "~3.1.5",
    "debug": "4.3.4"
  },
  "devDependencies": {
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/markdown": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kadena/types": "workspace:*",
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@kda-community-dev/vitest-config": "workspace:*",
    "@microsoft/api-extractor": "^7.43.1",
    "@types/debug": "~4.1.12",
    "@types/node": "^20.12.7",
    "@vitest/coverage-v8": "4.1.9",
    "@walletconnect/types": "~2.8.1",
    "jsdom": "^22.1.0",
    "msw": "^2.2.14",
    "oxlint": "1.63.0",
    "prettier": "~3.2.5",
    "ts-node": "~10.9.2",
    "typescript": "5.4.5",
    "vite": "8.0.10",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "provenance": true
  }
}
