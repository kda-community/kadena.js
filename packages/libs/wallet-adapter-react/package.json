{
  "name": "@kadena/wallet-adapter-react",
  "version": "0.0.7",
  "description": "Kadena Wallet Adapter React integration library",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/wallet-adapter-react"
  },
  "license": "BSD-3-Clause",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:local": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && api-extractor run --local",
    "format": "prettier . --cache --write",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kadena/wallet-adapter-core": "workspace:*"
  },
  "devDependencies": {
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@kda-community-dev/vitest-config": "workspace:*",
    "@microsoft/api-extractor": "^7.43.1",
    "@testing-library/react": "~16.3.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "oxlint": "1.63.0",
    "typescript": "5.4.5",
    "vite": "8.0.10",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "authors": [
    "Danillo Felixdaal",
    "Bart Huijgen"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  }
}
