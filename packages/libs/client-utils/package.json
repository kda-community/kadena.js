{
  "name": "@kadena/client-utils",
  "version": "0.13.4",
  "description": "Utility functions build as a wrapper around @kadena/client",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/client-utils"
  },
  "license": "BSD-3-Clause",
  "contributors": [
    "Javad Khalilian <javad@kadena.io>",
    "Albert Groothedde <albert@kadena.io>",
    "Nil Amrutlal <nil.amrutlal@deptagency.com>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./built-in": {
      "types": "./dist/built-in/index.d.ts",
      "development": "./src/built-in/index.ts",
      "import": "./dist/built-in/index.mjs",
      "require": "./dist/built-in/index.cjs"
    },
    "./coin": {
      "types": "./dist/coin/index.d.ts",
      "development": "./src/coin/index.ts",
      "import": "./dist/coin/index.mjs",
      "require": "./dist/coin/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "development": "./src/core/index.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./nodejs": {
      "types": "./dist/nodejs/index.d.ts",
      "development": "./src/nodejs/index.ts",
      "import": "./dist/nodejs/index.mjs",
      "require": "./dist/nodejs/index.cjs"
    },
    "./marmalade": {
      "types": "./dist/marmalade/index.d.ts",
      "development": "./src/marmalade/index.ts",
      "import": "./dist/marmalade/index.mjs",
      "require": "./dist/marmalade/index.cjs"
    },
    "./webauthn": {
      "types": "./dist/webauthn/index.d.ts",
      "development": "./src/webauthn/index.ts",
      "import": "./dist/webauthn/index.mjs",
      "require": "./dist/webauthn/index.cjs"
    },
    "./faucet": {
      "types": "./dist/faucet/index.d.ts",
      "development": "./src/faucet/index.ts",
      "import": "./dist/faucet/index.mjs",
      "require": "./dist/faucet/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "built-in": [
        "./dist/built-in/index.d.ts"
      ],
      "core": [
        "./dist/core/index.d.ts"
      ],
      "coin": [
        "./dist/coin/index.d.ts"
      ],
      "nodejs": [
        "./dist/nodejs/index.d.ts"
      ],
      "marmalade": [
        "./dist/marmalade/index.d.ts"
      ],
      "webauthn": [
        "./dist/webauthn/index.d.ts"
      ],
      "faucet": [
        "./dist/faucet/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run pactjs:generate:contract && pnpm run pactjs:generate:faucet && pnpm run generate-pipe-type && vite build",
    "dev:postinstall": "pnpm run pactjs:generate:contract && pnpm run pactjs:generate:faucet",
    "faucet:account-details": "TASK=account-details tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "faucet:balance": "TASK=balance tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "faucet:deploy": "TASK=deploy tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "faucet:fund": "TASK=fund tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "faucet:fund-create": "TASK=fund-create tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "faucet:transfer": "TASK=transfer tsx src/scripts/deploy-faucet/deploy-faucet.ts",
    "format": "pnpm run /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:md": "remark README.md -o --use @kadena-dev/markdown",
    "format:src": "prettier . --cache --write",
    "generate-pipe-type": "cache-sh -i \"{src/scripts/create-async-pipe-type.ts,src/interfaces/async-pipe-type.ts}\" \"tsx src/scripts/create-async-pipe-type.ts 30\"",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "oxlint .",
    "pactjs:generate:contract": "cache-sh -i \"node_modules/.kadena/**\" -- \"pactjs contract-generate --contract coin --contract marmalade-v2.ledger --contract marmalade-v2.collection-policy-v1 --contract marmalade-v2.policy-manager --contract marmalade-sale.conventional-auction --contract marmalade-sale.dutch-auction --contract n_eef68e581f767dd66c4d4c39ed922be944ede505.webauthn-wallet --api https://api.chainweb-community.org/chainweb/0.0/mainnet01/chain/8/pact\"",
    "pactjs:generate:faucet": "cache-sh -i \"node_modules/.kadena/**\" -- \"pactjs contract-generate --namespace n_d8cbb935f9cd9d2399a5886bb08caed71f9bad49 -f ./src/scripts/deploy-faucet/testnet-faucet.pact\"",
    "test": "vitest run",
    "test:integration": "pnpm run test:integration:setup && vitest run -c ./vitest.integration.config.ts",
    "test:integration:local": "vitest run -c ./vitest.integration.config.ts",
    "test:integration:setup": "pnpm run build && tsx src/scripts/setup-marmalade-test-env.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kadena/chainweb-node-client": "workspace:*",
    "@kadena/client": "workspace:*",
    "@kadena/cryptography-utils": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@kadena/pactjs-cli": "workspace:*",
    "@kadena/types": "workspace:*",
    "debug": "4.3.4",
    "dotenv": "~16.4.5",
    "js-yaml": "~4.1.0",
    "ramda": "^0.29.0"
  },
  "devDependencies": {
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/markdown": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@microsoft/api-extractor": "^7.43.1",
    "@types/debug": "~4.1.12",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20.12.7",
    "@types/ramda": "^0.29.5",
    "@vitest/coverage-v8": "^1.6.0",
    "cache-sh": "^1.2.1",
    "oxlint": "1.63.0",
    "prettier": "~3.2.5",
    "tsx": "4.22.3",
    "typescript": "5.4.5",
    "vite": "8.0.10",
    "vitest": "^1.6.0"
  }
}
