{
  "extends": "@kda-community-dev/typescript-config/react",
  "compilerOptions": {
    "types": ["node", "vitest-dom/extend-expect"],
    "skipLibCheck": true,
    "module": "ESNext",
    "declarationDir": "types",
    "outDir": "./dist",
    "allowJs": true,
    "moduleResolution": "Bundler",
    "removeComments": true
  },
  "include": ["src", "*.config.ts", "scripts"],
  "exclude": ["dist", "**/__tests__/**", "**/*.test.ts/**"]
}
