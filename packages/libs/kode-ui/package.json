{
  "name": "@kadena/kode-ui",
  "version": "0.21.1",
  "description": "A react component library built on Kadena's Kode Design System",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/kode-ui"
  },
  "license": "BSD-3-Clause",
  "author": "KADENA",
  "contributors": [
    "Eileen Guo <eileen@kadena.io>",
    "Salama Ashoush <salama@kadena.io>",
    "Sam Ferrero <ferrero@kadena.io>",
    "Robin Mulder <robin.mulder@kadena.io>",
    "Steven Straatemans <steven.straatemans@kadena.io>"
  ],
  "sideEffects": [
    "*.css.*",
    "dist/global.*",
    "dist/side-effects/**",
    "src/entries/global.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./global": {
      "types": "./dist/styles/global.d.ts",
      "import": "./dist/global.mjs",
      "require": "./dist/global.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns.mjs",
      "require": "./dist/patterns.cjs"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles.mjs",
      "require": "./dist/styles.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist\\index.cjs",
  "module": "./dist\\index.mjs",
  "types": "./dist\\index.d.ts",
  "files": [
    "dist",
    "global",
    "patterns",
    "styles"
  ],
  "scripts": {
    "build": "vite build",
    "build:storybook": "storybook build",
    "chromatic": "chromatic -b build:storybook",
    "dev": "vite dev",
    "format": "pnpm run --sequential /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:md": "remark README.md -o --use @kadena-dev/markdown",
    "format:src": "prettier . --cache --write",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "oxlint .",
    "storybook": "storybook dev -p 6006",
    "storybook:prod": "storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:sync": "design-sync sync",
    "verify": "tsc --noEmit"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not dead",
    "not IE 11"
  ],
  "dependencies": {
    "@artsy/fresnel": "^7.1.4",
    "@kadena/kode-icons": "workspace:*",
    "@react-aria/accordion": "3.0.0-alpha.25",
    "@react-aria/focus": "^3.16.0",
    "@react-aria/selection": "3.17.3",
    "@react-aria/utils": "^3.23.0",
    "@react-stately/table": "^3.11.4",
    "@react-stately/utils": "^3.9.0",
    "@react-types/grid": "^3.2.3",
    "@react-types/table": "^3.9.2",
    "@vanilla-extract/css": "1.14.2",
    "@vanilla-extract/css-utils": "^0.1.3",
    "@vanilla-extract/dynamic": "^2.1.2",
    "@vanilla-extract/recipes": "0.5.1",
    "@vanilla-extract/sprinkles": "1.6.1",
    "classnames": "^2.3.1",
    "framer-motion": "^11.18.2",
    "lodash.get": "^4.4.2",
    "lodash.mapvalues": "^4.6.0",
    "lodash.omit": "^4.5.0",
    "react": "^19.1.1",
    "react-aria": "^3.31.1",
    "react-dom": "^19.1.1",
    "react-intersection-observer": "^9.10.3",
    "react-stately": "^3.29.1",
    "react-use": "^17.4.0"
  },
  "devDependencies": {
    "@babel/preset-react": "7.29.7",
    "@chromatic-com/storybook": "^5.2.1",
    "@design-sync/cli": "^0.11.3",
    "@design-sync/vanilla-extract-plugin": "^0.7.3",
    "@etchteam/storybook-addon-status": "^5.0.0",
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/markdown": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@react-types/shared": "^3.22.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/addon-links": "10.4.1",
    "@storybook/csf": "^0.1.11",
    "@storybook/docs-mdx": "3.1.0",
    "@storybook/manager-api": "8.6.14",
    "@storybook/preview-api": "8.6.14",
    "@storybook/react": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@storybook/react-webpack5": "10.4.1",
    "@storybook/theming": "8.6.18",
    "@storybook/types": "8.6.14",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.5.1",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.mapvalues": "^4.6.7",
    "@types/lodash.omit": "^4.5.7",
    "@types/node": "^20.12.7",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vanilla-extract/vite-plugin": "4.0.17",
    "@vanilla-extract/webpack-plugin": "2.3.7",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "chromatic": "6.20.0",
    "copyfiles": "2.4.1",
    "csstype": "^3.1.2",
    "jiti": "^1.21.6",
    "mini-css-extract-plugin": "2.7.6",
    "oxlint": "1.63.0",
    "prettier": "~3.2.5",
    "prop-types": "^15.8.1",
    "rimraf": "~5.0.1",
    "storybook": "10.4.1",
    "storybook-dark-mode": "^4.0.2",
    "tiny-readdir-glob": "^1.2.1",
    "tsc-alias": "~1.8.7",
    "typescript": "5.4.5",
    "vite": "8.0.10",
    "vitest": "^1.6.0",
    "vitest-dom": "^0.1.1"
  }
}
