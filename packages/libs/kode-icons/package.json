{
  "name": "@kadena/kode-icons",
  "version": "0.3.1",
  "description": "Kadena's React icons library",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/kode-icons"
  },
  "license": "ISC",
  "author": "KADENA",
  "contributors": [
    "Salama Ashoush <salama@kadena.io>"
  ],
  "type": "module",
  "exports": {
    "./brand": {
      "types": {
        "import": "./dist/brand/esm/index.d.ts",
        "require": "./dist/brand/cjs/index.d.ts"
      },
      "import": "./dist/brand/index.mjs",
      "require": "./dist/brand/index.cjs"
    },
    "./product": {
      "types": {
        "import": "./dist/product/index.d.ts",
        "require": "./dist/product/index.d.ts"
      },
      "import": "./dist/product/index.mjs",
      "require": "./dist/product/index.cjs"
    },
    "./system": {
      "types": {
        "import": "./dist/system/index.d.ts",
        "require": "./dist/system/index.d.ts"
      },
      "import": "./dist/system/index.mjs",
      "require": "./dist/system/index.cjs"
    },
    ".": {
      "types": {
        "import": "./dist/system/index.d.ts",
        "require": "./dist/system/index.d.ts"
      },
      "import": "./dist/system/index.mjs",
      "require": "./dist/system/index.cjs"
    }
  },
  "main": "./dist/system/index.cjs",
  "module": "./dist/system/index.mjs",
  "types": "./dist/system/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "format": "pnpm run --sequential /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:md": "remark README.md -o --use @kadena-dev/markdown",
    "format:src": "prettier . --cache --write",
    "generate:icons": "jiti scripts/generateIcons.ts && pnpm build && pnpm run format:src",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "oxlint ."
  },
  "dependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/markdown": "workspace:*",
    "@kda-community-dev/oxlint-config": "workspace:*",
    "@kda-community-dev/typescript-config": "workspace:*",
    "@kda-community-dev/vite-config": "workspace:*",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "giget": "^1.2.1",
    "jiti": "^1.21.6",
    "oxlint": "1.63.0",
    "prettier": "~3.2.5",
    "scule": "^1.3.0",
    "tiny-readdir-glob": "^1.2.1",
    "typescript": "5.4.5",
    "vite": "8.0.10"
  }
}
