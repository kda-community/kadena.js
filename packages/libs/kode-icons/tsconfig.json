{
  "extends": "@kda-community-dev/typescript-config/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "module": "ESNext",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "removeComments": true
  },
  "include": ["src/**/*", "scripts", "vite.config.ts"],
  "exclude": ["dist"]
}
