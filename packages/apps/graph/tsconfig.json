{
  "extends": "@kda-community-dev/typescript-config/node",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "types": [".kadena/pactjs-generated", "node"],
    "paths": {
      "@db/*": ["./db/*"],
      "@services/*": ["./services/*"],
      "@utils/*": ["./src/utils/*"],
      "@devnet/*": ["./src/devnet/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["dist", "**/tests/**"]
}
